{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editor",
  "compatibility_date": "2025-08-03",
  "main": "./src/server/index.tsx",
  "durable_objects": {
    "bindings": [
      {
        "name": "EDITOR_SERVER_DURABLE",
        "class_name": "EditorServerDurable"
      }
    ],
  },
  "exports": {
    "EditorServerDurable": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
